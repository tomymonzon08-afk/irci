.section ".data"


palabra: .asciiz "computadora"

.section ".text"
    addi $sp, $zero, 0xFFC     
    addi $s3, $zero, -0x100    
    orh  $a0, $zero, .hi16 palabra
    ori  $a0, $a0, .lo16 palabra
    jal  invertir_e_imprimir
    trap 1                    


invertir_e_imprimir:
    addi $sp, $sp, -8
    sw   $s0, 0($sp)           
    sw   $s1, 4($sp)          
    addi $s0, $a0, 0           
    addi $s1, $zero, 0        

contar_bucle:
    lbu  $t0, 0($s0)
    beq  $t0, $zero, contar_fin   
    addi $s0, $s0, 1
    addi $s1, $s1, 1
    j    contar_bucle

contar_fin:
    addi $s0, $s0, -1

imprimir_bucle:
    beq  $s1, $zero, imprimir_fin  
    lbu  $t0, 0($s0)               
    sb   $t0, 0($s3)              
    addi $s0, $s0, -1            
    addi $s1, $s1, -1              
    j    imprimir_bucle

imprimir_fin:
    addi $t0, $zero, '\r'
    sb   $t0, 0($s3)
    addi $t0, $zero, '\n'
    sb   $t0, 0($s3)
    lw   $s0, 0($sp)           
    lw   $s1, 4($sp)           
    addi $sp, $sp, 8
    jr   $ra, 0
